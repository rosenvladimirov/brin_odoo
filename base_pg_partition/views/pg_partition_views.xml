<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Server action: open partition dashboard -->
    <record id="action_pg_partition_dashboard" model="ir.actions.server">
        <field name="name">PostgreSQL Partitions</field>
        <field name="model_id" ref="base.model_ir_ui_menu"/>
        <field name="state">code</field>
        <field name="code">
action = env['pg.partition.manager'].sudo().get_partition_info()
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_pg_partition_root"
              name="PG Partitions"
              parent="base_setup.action_general_configuration"
              sequence="100"/>

    <menuitem id="menu_pg_partition_backup"
              name="Backup Partition"
              parent="menu_pg_partition_root"
              action="action_partition_backup_wizard"
              sequence="10"/>
</odoo>
